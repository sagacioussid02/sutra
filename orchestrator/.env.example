# Copy to .env (gitignored) and fill in real values.

# Where the Sutra gateway is listening.
SUTRA_GATEWAY_URL=http://127.0.0.1:8765

# Your bearer token, the `token:` value for your user in gateway/tokens.yaml.
SUTRA_TOKEN=

# Anthropic API key. Tool results (including finanxe data) are sent to the
# Anthropic API as model context.
ANTHROPIC_API_KEY=

# Model that talks to you and picks tools.
SUTRA_MODEL=claude-sonnet-5-5

# Small, fast model that classifies yes/no replies to confirmations.
SUTRA_CLASSIFIER_MODEL=claude-haiku-5-5

# --- Memory -------------------------------------------------------------
# on/off. Off runs with no memory at all.
SUTRA_MEMORY=on
# Where the memory databases live (created private, owner-only).
SUTRA_MEMORY_DIR=data
# Small model that extracts things you tell it about yourself.
SUTRA_EXTRACTOR_MODEL=claude-haiku-5-5
# Store the assistant's reply text in the conversation log (on/off). Replies can
# contain financial figures; turn off to store only what you said and tool names.
SUTRA_RECORD_REPLIES=on
# Conversations older than this many days are moved to a separate archive file
# and never used as context. Nothing is ever deleted automatically.
SUTRA_EPISODE_HOT_DAYS=30
