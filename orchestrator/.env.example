# Copy to .env (gitignored) and fill in real values.
# Every variable below is read by orchestrator/src/sutra_orchestrator/config.py
# or voice/config.py; the values shown are the defaults when a line is left out.
# Real environment variables win over .env.

# Where the Sutra gateway is listening.
SUTRA_GATEWAY_URL=http://127.0.0.1:8765

# Your bearer token, the `token:` value for your user in gateway/tokens.yaml.
SUTRA_TOKEN=

# Anthropic API key. Tool results (including financial data) are sent to the
# Anthropic API as model context.
ANTHROPIC_API_KEY=

# --- Models and the turn loop --------------------------------------------
# Model that talks to you and picks tools.
SUTRA_MODEL=claude-sonnet-5-5
# Small, fast model that classifies yes/no replies to confirmations.
SUTRA_CLASSIFIER_MODEL=claude-haiku-5-5
# Small model that extracts things you tell it about yourself.
SUTRA_EXTRACTOR_MODEL=claude-haiku-5-5
# Most tool calls the assistant may make in one turn.
SUTRA_MAX_TOOL_CALLS=6
# Conversation turns kept as context.
SUTRA_HISTORY_TURNS=20
# Tool results longer than this many bytes are truncated.
SUTRA_MAX_RESULT_BYTES=16000
# Times the assistant re-asks when it cannot hear or understand you.
SUTRA_REASK_LIMIT=2

# --- Memory -------------------------------------------------------------
# on/off. Off runs with no memory at all.
SUTRA_MEMORY=on
# Where the memory databases live (created private, owner-only).
SUTRA_MEMORY_DIR=data
# Store the assistant's reply text in the conversation log (on/off). Replies can
# contain financial figures; turn off to store only what you said and tool names.
SUTRA_RECORD_REPLIES=on
# Conversations older than this many days are moved to a separate archive file
# and never used as context. Nothing is ever deleted automatically.
SUTRA_EPISODE_HOT_DAYS=30

# --- Interests, reflection, and the episode graph ------------------------
# on/off. Interests the assistant has learned about you; reflection is the
# nightly pass that records them.
SUTRA_INTERESTS=on
SUTRA_REFLECTION=on
# How often reflection runs, and how far back it looks.
SUTRA_REFLECTION_HOURS=24
SUTRA_REFLECTION_DAYS=30
# Tools whose calls are never used as reflection material (comma-separated prefixes).
SUTRA_REFLECTION_EXCLUDE_TOOLS=finanxe_
# Hours after an interest is recorded before the assistant may nudge you about it.
SUTRA_NUDGE_HOURS=24
# Where the interests database lives. Defaults to SUTRA_MEMORY_DIR when unset.
#SUTRA_INTERESTS_DIR=data
# on/off. The graph of people, places, and topics from your conversations.
SUTRA_GRAPH=on
# Where the graph database lives. Defaults to SUTRA_MEMORY_DIR when unset.
#SUTRA_GRAPH_DIR=data

# --- Offers ---------------------------------------------------------------
# on/off. Proactive offers ("something turned up for your Diwali plans...").
SUTRA_OFFERS=on
# Where the offers database lives. Defaults to SUTRA_MEMORY_DIR when unset.
#SUTRA_OFFERS_DIR=data
# Most offers spoken per day, and most outside-signal checks per day.
SUTRA_OFFERS_DAILY_MAX=4
SUTRA_OFFERS_CALLS=200
# Outside-signal sources treated as urgent (comma-separated).
#SUTRA_OFFERS_URGENT_SOURCES=

# --- World state --------------------------------------------------------------
# on/off. A short "what is true right now" block in replies, with ages
# (open reminders and offers, what is coming up, a presence hint you set with
# /state presence). Stale lines are marked stale; missing ones are never guessed.
SUTRA_WORLDSTATE=on
# Seconds a source may take before its line is left out, and the block's size.
#SUTRA_WORLDSTATE_TIMEOUT=2
#SUTRA_WORLDSTATE_CHARS=700
# Minutes before the calendar line, and the finance pointer, are marked stale.
#SUTRA_WORLDSTATE_CALENDAR_TTL=5
#SUTRA_WORLDSTATE_FINANCE_TTL=15

# --- Inbound events ---------------------------------------------------------
# on/off. A local listener takes events the gateway forwards from registered
# producers (see gateway/events.example.yaml). Off by default: it opens a port.
#SUTRA_EVENTS=off
# Where the event log lives. Defaults to SUTRA_MEMORY_DIR when unset.
#SUTRA_EVENTS_DIR=data
# Loopback port the gateway forwards to, and the shared secret it must send
# (must equal forward_secret in the gateway's events.yaml). No secret, no intake.
#SUTRA_EVENTS_PORT=8766
#SUTRA_EVENTS_SECRET=
# Most events kept in the log, days delivered events are kept, and how many
# times a consumer may fail on one event before it is skipped.
#SUTRA_EVENTS_CAP=5000
#SUTRA_EVENTS_RETENTION_DAYS=30
#SUTRA_EVENTS_MAX_ATTEMPTS=3

# --- Safety and authentication --------------------------------------------
# Startup mode: full (all tools), limited (only SUTRA_LIMITED_TOOLS), off.
SUTRA_START_MODE=full
# Tools allowed in limited mode (comma-separated).
#SUTRA_LIMITED_TOOLS=
# on/off. Adaptive authentication: one-time questions drawn from your own
# activity before sensitive actions.
SUTRA_AUTH=off
# Questions asked to confirm it is you when entering auth mode, and how many
# successful confirmations a sensitive action needs.
SUTRA_AUTH_MODE_QUESTIONS=1
SUTRA_AUTH_ACTION_NEED=2
# Tools that always need that confirmation (comma-separated).
#SUTRA_AUTH_TOOLS=
# Where the auth database lives. Defaults to SUTRA_MEMORY_DIR when unset.
#SUTRA_AUTH_DIR=data
# Duress phrase: saying it makes the assistant act as if you are under duress.
# Keep it secret; it is never shown or logged. At least two words (or 8 chars).
#SUTRA_DURESS_PHRASE=
# Where the safety database lives. Defaults to SUTRA_MEMORY_DIR when unset.
#SUTRA_SAFETY_DIR=data
# How the assistant refers to itself: feminine, masculine, or neutral.
SUTRA_ASSISTANT_GENDER=feminine
# How a voice conversation starts: button (press to talk) or wake (wake word).
SUTRA_ACTIVATION=button
# Wake words (comma-separated), when SUTRA_ACTIVATION=wake.
SUTRA_WAKE_WORDS=hey sutra,sutra

# --- Hangout (group chat) --------------------------------------------------
# URL of the group-chat service the assistant joins for hangouts; unset disables it.
#SUTRA_GOSSIP_URL=
# Voices available in hangouts (comma-separated).
#SUTRA_HANGOUT_VOICES=

# --- Feeds, news, and local context -----------------------------------------
# on/off. Feeds the assistant watches for you.
SUTRA_FEEDS=on
# Your home area, used for local topics ("local events and things to do").
#SUTRA_HOME_AREA=Orem, Utah
# on/off. News topics the assistant may research for you.
SUTRA_NEWS=off
# News topics (comma-separated).
#SUTRA_NEWS_TOPICS=
# Units for weather and distances: imperial or metric.
SUTRA_UNITS=imperial

# --- Life, humor, and lessons ----------------------------------------------
# on/off. Life events the assistant keeps track of (birthdays, trips, ...).
SUTRA_LIFE=on
# Where the life database lives. Defaults to SUTRA_MEMORY_DIR when unset.
#SUTRA_LIFE_DIR=data
# on/off. Humor in replies.
SUTRA_HUMOR=on
# Where the personality database lives. Defaults to SUTRA_MEMORY_DIR when unset.
#SUTRA_PERSONALITY_DIR=data
# on/off. Lessons the assistant learns from corrections and mistakes.
SUTRA_LESSONS=on
# on/off. Whether lessons are reviewed in reflection.
SUTRA_LESSONS_REFLECTION=on
# Where the lessons database lives. Defaults to SUTRA_MEMORY_DIR when unset.
#SUTRA_LESSONS_DIR=data

# --- Idle research and ephemeral research agents -----------------------------
# on/off. Background research on your interests while you are away.
SUTRA_IDLE_RESEARCH=off
# Where the idle-research database lives. Defaults to SUTRA_MEMORY_DIR when unset.
#SUTRA_IDLE_DIR=data
# Most idle runs per day, minimum hours of quiet before a run, most web
# searches per run, and the per-run output-token budget.
SUTRA_IDLE_DAILY_RUNS=1
SUTRA_IDLE_MIN_HOURS=48
SUTRA_IDLE_MAX_SEARCHES=2
SUTRA_IDLE_RUN_TOKENS=3000
# on/off. Ephemeral research agents ("research ...", idle research topics).
SUTRA_AGENTS=on
# Model research agents use.
SUTRA_AGENT_MODEL=claude-haiku-5-5
# Gateway tools research agents may call (comma-separated; empty means none).
#SUTRA_AGENT_TOOLS=
# Where the research-run database lives. Defaults to SUTRA_MEMORY_DIR when unset.
#SUTRA_AGENTS_DIR=data
# Per-run limits: web searches, tool calls, output tokens, seconds.
SUTRA_AGENT_MAX_SEARCHES=5
SUTRA_AGENT_MAX_TOOL_CALLS=5
SUTRA_AGENT_RUN_TOKENS=8000
SUTRA_AGENT_TIMEOUT=180
# Daily limits: runs per day, output tokens per day.
SUTRA_AGENT_DAILY_RUNS=3
SUTRA_AGENT_DAILY_TOKENS=60000

# --- Reminders ------------------------------------------------------------
# on/off. Off means "remind me ..." is handled like any other request.
SUTRA_REMINDERS=on
# Where the reminders database lives (created private, owner-only).
# Defaults to the memory directory when unset.
SUTRA_REMINDERS_DIR=data
# "Remind me at 5pm" is read in this timezone.
SUTRA_REMINDERS_TZ=America/Denver

# --- Voice -------------------------------------------------------------------
# cloud (OpenAI speech services) or private (on-device speech).
SUTRA_VOICE_MODE=cloud
# OpenAI API key, needed only in cloud voice mode.
OPENAI_API_KEY=
# Name the assistant answers to.
SUTRA_ASSISTANT_NAME=Sutra
# Cloud speech-to-text model, text-to-speech model, and TTS voice.
SUTRA_STT_MODEL=gpt-4o-transcribe
SUTRA_TTS_MODEL=gpt-4o-mini-tts
SUTRA_TTS_VOICE=coral
# TTS speaking style, e.g. "warm and unhurried". Empty means the model default.
#SUTRA_TTS_STYLE=
# Language for speech recognition, e.g. "en" or "hi". Empty means auto-detect.
#SUTRA_LANGUAGE=
# On-device speech models (private voice mode): Whisper model and voice.
SUTRA_LOCAL_STT_MODEL=base.en
#SUTRA_LOCAL_VOICE=
# On-device Hindi voice (private voice mode).
SUTRA_LOCAL_VOICE_HI=Lekha
# Language for on-device speech recognition (private voice mode).
#SUTRA_LOCAL_STT_LANGUAGE=
# Below this confidence a reply to a held action is not acted on (0.0-1.0).
SUTRA_MIN_CONFIDENCE=0.5
# Seconds before a filler ("one moment...") while the assistant thinks.
SUTRA_FILLER_DELAY=1.0
# Where voice recordings are saved; empty means recordings are not kept.
#SUTRA_RECORD_AUDIO_DIR=
# on/off. Stop listening automatically when you stop speaking.
SUTRA_AUTO_STOP=on
# Milliseconds of silence that end your turn, and of no speech before giving up.
SUTRA_SILENCE_MS=1200
SUTRA_NO_SPEECH_MS=6000
# on/off. Keep the conversation open across turns instead of one-shot replies.
SUTRA_CONVERSATION=on
# Most background tasks the voice loop runs at once.
SUTRA_MAX_BACKGROUND=2
# Seconds before the assistant says it is still working on a slow reply.
SUTRA_WAIT_NOTICE_DELAY=4.0
# on/off. Stream the reply out loud as it is generated.
SUTRA_STREAM_REPLY=on
# Words and names to hint the speech recognizer with (comma-separated).
#SUTRA_STT_HINTS=
# Barge-in while the assistant is speaking: on, off, or auto (on for headphones).
SUTRA_BARGE_IN=auto
