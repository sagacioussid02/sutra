<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs one sutra-watch health pass every 5 minutes.
     deploy/install-macos.sh fills in __REPO_DIR__ and __LOG_DIR__. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sutra.watch</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO_DIR__/deploy/run-watch.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__LOG_DIR__/watch.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/watch.log</string>
</dict>
</plist>
