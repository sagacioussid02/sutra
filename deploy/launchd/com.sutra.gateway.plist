<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keeps the Sutra gateway running: starts at login, restarts if it exits.
     deploy/install-macos.sh fills in __REPO_DIR__ and __LOG_DIR__. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sutra.gateway</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO_DIR__/deploy/run-gateway.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Don't spin if it keeps crashing (bad config): wait 30 s between tries. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>__LOG_DIR__/gateway.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/gateway.log</string>
</dict>
</plist>
