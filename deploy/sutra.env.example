# Copy to ~/.config/sutra/sutra.env and `chmod 600` it. Never commit the real file.
# Both the gateway and sutra-watch read it at start.

# finanxe's API token: the same value finanxe uses (its FINANXE_API_TOKEN, or
# the contents of finanxe/poc/backend/.finanxe_api_token). Without it every
# finanxe tool fails with 401.
FINANXE_API_TOKEN=

# The SPY desk adapter's token (week 1). Leave empty until the desk adapter exists.
SPY_DESK_TOKEN=

# Optional: twin's session secret (see cmd/gateway -twin-session-secret).
TWIN_SESSION_SECRET=

# ntfy topic sutra-watch pushes alerts to. Anyone who knows a topic name can
# read it, so keep it here, not in the repo.
SUTRA_WATCH_NTFY_TOPIC=
# Only if the topic needs auth:
SUTRA_WATCH_NTFY_TOKEN=

# Optional overrides
# SUTRA_GATEWAY_ADDR=127.0.0.1:8765
# SUTRA_GATEWAY_EXTRA_FLAGS="-finanxe-user-id demo_user"
